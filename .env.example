# ── 楽天ウェブサービス ──────────────────────────────
# https://webservice.rakuten.co.jp/app/create で取得
RAKUTEN_APP_ID=
# 楽天直アフィリエイトを使う場合のID（もしも経由なら未設定でも可）
RAKUTEN_AFFILIATE_ID=

# ── アフィリンクのプロバイダ切替 ─────────────────────
# rakuten_direct | moshimo
AFFILIATE_PROVIDER=rakuten_direct
# もしもアフィリエイト クリック計測リンク用ID（provider=moshimo時）
MOSHIMO_A_ID=
MOSHIMO_RAKUTEN_P_ID=
MOSHIMO_RAKUTEN_PC_ID=
MOSHIMO_RAKUTEN_PL_ID=
MOSHIMO_AMAZON_P_ID=
MOSHIMO_AMAZON_PC_ID=
MOSHIMO_AMAZON_PL_ID=
MOSHIMO_YAHOO_P_ID=
MOSHIMO_YAHOO_PC_ID=
MOSHIMO_YAHOO_PL_ID=

# ── サイト ──────────────────────────────────────────
SITE_BASE_URL=https://example.com
SITE_NAME=トレンド価格ウォッチ
SITE_OPERATOR=運営者名

# ── LLM（Google AI Studio・無料枠。任意） ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── X（投稿専用。読み取りは無料枠不可） ─────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USERNAME=

# ── 計測（公式API・任意。鍵未設定ならスキップ） ─────
GSC_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service_account.json

# ── 連携（任意・REST API・フェイルソフト） ──────────
NOTION_API_KEY=
NOTION_DASHBOARD_DB=
GITHUB_TOKEN=
GITHUB_REPO=

# ── 監視通知（失敗時のみ・任意） ────────────────────
ALERT_WEBHOOK_URL=
